# ==============================================================================
# Gitea Platform - Centralized Environment Configuration
# Copy this file to env.conf and update the values as needed.
# All values will be dynamically injected into ArgoCD and Kubernetes manifests.
# ==============================================================================

# AWS & Infrastructure
AWS_REGION="ap-south-1"
CLUSTER_NAME="gitea-eks-cluster"

# Application Domains (leave blank or use git.local if accessing via port-forward / ALB)
GITEA_DOMAIN="git.local"
ARGOCD_DOMAIN="argocd.local"
GRAFANA_DOMAIN="grafana.local"

# Administration Usernames (Passwords are auto-generated dynamically into K8s Secrets)
# Gitea admin password and Grafana admin password are generated at deployment time
# and require a mandatory password update upon first login (NIST 800-63B compliant).
GITEA_ADMIN_USER="gitea_admin"
GRAFANA_ADMIN_USER="admin"

# Datadog Observability Configuration
# Set DATADOG_ENABLED="true" and provide your API Key when you are ready to use Datadog.
# If set to "false" or left blank, Datadog will be safely skipped with NO errors.
DATADOG_ENABLED="false"
DATADOG_SITE="datadoghq.com"             # e.g., datadoghq.com, us3.datadoghq.com, datadoghq.eu
DATADOG_API_KEY=""                      # Your Datadog API Key
DATADOG_APP_KEY=""                      # Your Datadog App Key (optional)

# Monitoring Retention (in days)
PROMETHEUS_RETENTION_DAYS="7"
